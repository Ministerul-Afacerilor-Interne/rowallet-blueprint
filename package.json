{
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prestart": "npm run render:diagrams",
    "start": "docusaurus start",
    "start:local": "PUML_URL=http://localhost:8080/plantuml npm run start",
    "prebuild": "npm run render:diagrams",
    "build": "docusaurus build",
    "build:local": "PUML_URL=http://localhost:8080/plantuml npm run build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "render:diagrams": "node scripts/render-plantuml.cjs",
    "check:site": "node scripts/check-built-site.cjs",
    "release:report": "node scripts/release.cjs report",
    "release:prepare": "node scripts/release.cjs prepare",
    "release:verify": "node scripts/release.cjs verify",
    "test": "npm run lint && npm run build && npm run check:site",
    "test:local": "PUML_URL=http://localhost:8080/plantuml npm test",
    "lint": "markdownlint 'architecture-proposal/**/*.md' --ignore node_modules",
    "lint:fix": "markdownlint 'architecture-proposal/**/*.md' --ignore node_modules --fix"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^13.2.4",
    "docusaurus-plugin-llms": "^0.5.1",
    "markdownlint-cli": "^0.45.0",
    "semantic-release": "^24.2.1"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "docusaurus-plugin-image-zoom": "^3.0.1",
    "plantuml-encoder": "^1.4.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  }
}
